# [LIVE-5] Conta R, no dl380: a conta que opera em CORRETORA (Binance Demo ou real). É a única
# instância que pode sair do papel: sobe com CORRETORA_HABILITADA=1, e as outras três recusam o
# boot se o banco delas estiver em modo corretora (`api._guarda_corretora`). Mesmo código das
# contas A, B e C, com banco, log e porta próprios. Escuta só em loopback: quem a expõe é a
# conta A, na rota /testeR/... (api.conta_real), atrás da mesma senha do painel. Em `binance`
# essa senha só APERTA limites; afrouxar e ligar o envio real é no servidor (`api._so_aperta`).
#
# ONDE A CHAVE MORA, sem exagero (revisão de 26/11). A chave da Binance não vai no `.env`
# compartilhado: fica em /home/cripto/cripto-bot-r/corretora.env, que só esta unit CARREGA. Isso
# tira a chave do AMBIENTE das contas de papel, e só. As quatro units rodam como o mesmo usuário
# `cripto`: um processo da A (exposto na internet) consegue ler esse arquivo e o
# /proc/<pid>/environ da R. O que impede a A de operar a conta é `CORRETORA_HABILITADA`, não a
# permissão do arquivo. Isolar de verdade = um usuário Linux só da R (RUNBOOK-VM.md §0.1, "Isolar
# a chave"), decisão do dono porque mexe nas permissões do código das quatro.
#
# Instalar (uma vez). Quem cria o arquivo da chave é o DONO, no servidor; ela não passa por
# chat nem pelo repositório (ele é público):
#   sudo install -d -o cripto -g cripto -m 700 /home/cripto/cripto-bot-r
#   sudo -u cripto sh -c 'umask 077; cat > /home/cripto/cripto-bot-r/corretora.env'
#       BINANCE_DEMO_KEY=...        (fase demo)
#       BINANCE_DEMO_SECRET=...
#       BINANCE_KEY=...             (só no go-live; leitura + futuros, sem saque, com IP fixo)
#       BINANCE_SECRET=...
#     (termina com Ctrl-D numa linha vazia)
#   sudo cp deploy/cripto-bot-r.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now cripto-bot-r
#
# A conta nasce em PAPEL, com a config padrão do código e `auto_trade=0`. A escada para ligar,
# com os comandos exatos, está no RUNBOOK-VM.md §0.1. Resumo: (1) a estratégia da A copiada
# por `python -m execucao config-de`, com banca e teto de perda desta conta; (2) demo; (3)
# papel + reset, binance com dry_run=1; (4) envio real ligado NO SERVIDOR; (5) o dono liga o
# auto_trade. Trocar de corretora exige auto_trade=0.
#
# Pânico sem painel: `sudo bash deploy/panico.sh` (no servidor) desliga o bot, cancela tudo e
# fecha tudo na corretora, mesmo com este serviço travado (ele o PARA antes do caminho direto).
#
# O deploy da A (git pull no /home/cripto/cripto-bot) troca o código das quatro: depois dele,
# reinicie os QUATRO serviços (/testeR/health mostra o commit). Reiniciar esta unit é seguro com
# posição aberta: stop e alvos estão na corretora, e o boot começa pela reconciliação.
[Unit]
Description=Cripto Bot - conta R (opera em corretora)
# time-sync: com o relógio errado a Binance recusa tudo (-1021). O servidor liga de manhã, e o
# processo subindo antes do NTP passava a primeira hora recusado.
After=network-online.target time-sync.target cripto-bot.service
Wants=network-online.target

[Service]
Type=simple
User=cripto
WorkingDirectory=/home/cripto/cripto-bot
EnvironmentFile=/home/cripto/cripto-bot/.env
EnvironmentFile=/home/cripto/cripto-bot-r/corretora.env
Environment=TZ=America/Sao_Paulo
# CONTA, DB_PATH e LOG_PATH vão pelo `env` do ExecStart, e NÃO por `Environment=`: o `.env` da
# A define DB_PATH, e no systemd o EnvironmentFile VENCE o Environment= (o incidente de 10/11).
# CORRETORA_HABILITADA vai junto pelo mesmo motivo: é a linha que separa esta conta das de papel,
# e não pode depender de um arquivo que as outras também leem.
ExecStart=/usr/bin/env CONTA=R CORRETORA_HABILITADA=1 DB_PATH=/home/cripto/cripto-bot-r/trading.db LOG_PATH=/home/cripto/cripto-bot-r/plataforma.log /home/cripto/cripto-bot/venv/bin/uvicorn api:app --host 127.0.0.1 --port 8003
Restart=always
RestartSec=5
WatchdogSec=300
NotifyAccess=main
MemoryHigh=620M
MemoryMax=760M
# Endurecimento que não precisa de namespace (funciona dentro do contêiner LXC). PrivateTmp,
# ProtectSystem e ProtectHome precisam de namespace de montagem e podem impedir a unit de subir
# num contêiner sem privilégio: só entram depois de testados lá (RUNBOOK-VM.md §0.1).
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=multi-user.target
