# [LIVE-12] Backup do banco da conta R (dinheiro real). Disparado por cripto-bot-r-backup.timer.
# Instalar junto com o timer:
#   sudo cp deploy/cripto-bot-r-backup.service deploy/cripto-bot-r-backup.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now cripto-bot-r-backup.timer
# Conferir: systemctl list-timers cripto-bot-r-backup.timer ; journalctl -u cripto-bot-r-backup -n 5
[Unit]
Description=Cripto Bot - backup do banco da conta R

[Service]
Type=oneshot
User=cripto
UMask=0077
Environment=TZ=America/Sao_Paulo
ExecStart=/home/cripto/cripto-bot/venv/bin/python /home/cripto/cripto-bot/deploy/backup_banco.py /home/cripto/cripto-bot-r/trading.db /home/cripto/backup-r --manter 30
