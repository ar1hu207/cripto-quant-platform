# Copie pra /home/ubuntu/cripto-bot/.env e troque a senha. chmod 600 .env
DB_PATH=/home/ubuntu/cripto-bot/trading.db
DASH_USER=admin
# Obrigatório em qualquer deploy que a internet alcance: SEM DASH_PASS o backend responde
# 503 para tudo que vier pelo Caddy (só atende loopback). Não há bandeira para desligar isso.
# Gere uma senha forte:  openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 24
DASH_PASS=TROQUE_POR_UMA_SENHA_FORTE

# Só quando o front está separado (Vercel). Origem EXATA, sem barra no fim.
# Várias separadas por vírgula. Deixe fora do arquivo no modo monolito.
# CORS_ORIGINS=https://meu-bot.vercel.app,https://meu-bot-git-main-voce.vercel.app
